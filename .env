# ─── GitHub OAuth (required for OAuth login) ─────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL:        http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/github

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Notes ───────────────────────────────────────────────────────────────────
# No database! Drafts live in the user's browser (localStorage).
# Publish writes index.html + folio.json to the user's GitHub repo & enables Pages.
# Token login (GitHub PAT) works without GITHUB_CLIENT_ID/SECRET set.
# For Vercel: add GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET under Environment Variables.
