# ─── GitHub OAuth (required) ─────────────────────────────────────────────────
# Create an OAuth App: https://github.com/settings/developers → New OAuth App
# Homepage URL: https://your-domain.vercel.app
# Authorization callback URL: https://your-domain.vercel.app/api/auth/github

GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Notes ───────────────────────────────────────────────────────────────────
# No database. Drafts live in the user's browser (localStorage).
# Publish writes index.html + folio.json to the user's GitHub repo and enables Pages.
# On Vercel: add GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET under Environment Variables.

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.developers.google.com/ → New Project → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:8080/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
