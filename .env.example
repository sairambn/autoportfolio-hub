# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase project ID (just the id, e.g. abcdefghijkl)
SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase Publishable/Anon key (safe to expose in client)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# Supabase Service Role key — SERVER ONLY, never expose to client!
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ─── GitHub OAuth (optional — enables push-to-repo feature) ──────────────────
# Only needed if you want users to connect their GitHub and publish portfolios.
# Uses Lovable's App User Connector gateway.
# GITHUB_APP_USER_CONNECTOR_CLIENT_API_KEY=your-lovable-connector-key
# LOVABLE_API_KEY=your-lovable-api-key
# APP_USER_CONNECTION_KEY_SECRET=your-32-byte-base64-secret

# ─── Notes ───────────────────────────────────────────────────────────────────
# 1. Copy this file to .env and fill in your values.
# 2. For Vercel: add these under Project Settings → Environment Variables.
# 3. Google sign-in: enable Google provider in Supabase Dashboard →
#    Authentication → Providers → Google. Add your Google OAuth client ID/secret.
#    Set redirect URL in Google Console to:
#    https://your-project-id.supabase.co/auth/v1/callback
