# ─── Google OAuth ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# Application type: Web application
# Authorized JavaScript origins: https://your-domain.vercel.app
# Authorized redirect URIs: https://your-domain.vercel.app/api/auth/google
#
# Local: http://localhost:3000 and http://localhost:3000/api/auth/google

GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ─── GitHub OAuth (optional — for one-click GitHub login) ─────────────────────
# https://github.com/settings/developers → New OAuth App
# Callback: https://your-domain.vercel.app/api/auth/github

GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Notes ───────────────────────────────────────────────────────────────────
# No central database. Drafts live in the browser (localStorage).
# Publish writes static files to the user's GitHub repo (needs GitHub token / OAuth).
# On Vercel: set the env vars above for Production + Preview, then redeploy.
