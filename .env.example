# ─── Google OAuth (Firebase / Google Cloud project) ─────────────────────────
# Firebase project number: 217654885285
# Open: https://console.firebase.google.com/project/_/settings/general
# Or Google Cloud Console → APIs & Services → Credentials
#
# 1. Create OAuth client ID → Application type: Web application
# 2. Authorized JavaScript origins:
#      https://portfoliobuilder-three.vercel.app
#      http://localhost:5173
#      http://localhost:3000
# 3. Authorized redirect URIs:
#      https://portfoliobuilder-three.vercel.app/api/auth/google
#      http://localhost:5173/api/auth/google
#      http://localhost:3000/api/auth/google
# 4. Copy Client ID and Client Secret into Vercel env vars (Production + Preview)
# 5. Redeploy after saving env vars

GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ─── GitHub OAuth (optional — for one-click GitHub login) ─────────────────────
# https://github.com/settings/developers → New OAuth App
# Homepage: https://portfoliobuilder-three.vercel.app
# Callback: https://portfoliobuilder-three.vercel.app/api/auth/github

GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (optional — only if using cloud auth) ──────────────────────────
# Leave empty for localStorage-only / guest mode. Site will not crash without these.

# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ─── Notes ───────────────────────────────────────────────────────────────────
# No central database required. Drafts live in the browser (localStorage).
# Publish writes static files to the user's GitHub repo (needs GitHub token / OAuth).
# On Vercel: set GOOGLE_* and GITHUB_* for Production + Preview, then redeploy.
# Firebase project number used for Google OAuth: 217654885285
